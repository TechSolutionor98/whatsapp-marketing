# Copy this file to ".env" and fill in your values. The .env file is gitignored.

# --- MongoDB (required for login) ---
# Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017
#
# MongoDB Atlas (cloud) — paste the connection string from Atlas → "Connect" → "Drivers".
# Replace <username> and <password> with the database user you created.
MONGODB_URI=mongodb+srv://<username>:<password>@yourcluster.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database name to use inside the cluster (created automatically).
MONGODB_DB=pulse_wa

# --- Superadmin (owner) account ---
# Seeded automatically on startup if it doesn't already exist. This is the ONLY
# way the first account is created (there is no public signup). The superadmin
# then creates all other users from the Authentication page.
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-this-strong-password

# --- Optional ---
# Secret used to sign login cookies. If omitted, one is generated in data/.jwt_secret.
# JWT_SECRET=change-me-to-a-long-random-string

# --- AI message variation (optional, recommended for anti-ban) ---
# Free Groq API key (default provider), from https://console.groq.com/keys (no card).
# When set, each outreach message is AI-rewritten into a unique variation per
# recipient. Enable + pick provider/model/tone in the app under Settings → AI.
# Works with any OpenAI-compatible provider: Groq (default), Google Gemini,
# a local Ollama server (no key needed), or a custom endpoint — chosen in Settings.
AI_API_KEY=

# Server port
# PORT=4000
